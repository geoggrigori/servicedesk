# Copy to .env and adjust. Every value here is a safe local default.

SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Sao_Paulo
LOG_LEVEL=INFO

# Leave unset to fall back to SQLite at db.sqlite3
# DATABASE_URL=postgres://servicedesk:servicedesk@db:5432/servicedesk

CELERY_BROKER_URL=redis://localhost:6379/0
# Run tasks inline instead of through a worker, handy while developing
CELERY_TASK_ALWAYS_EAGER=False
# How often the SLA sweeper runs, in minutes
SLA_SWEEP_MINUTES=5

# With DEBUG=False the app turns on HTTPS redirects, HSTS and secure cookies.
# Set this to False if you terminate TLS somewhere that cannot forward the
# X-Forwarded-Proto header, otherwise you get a redirect loop.
# SECURE_SSL_REDIRECT=True

# Business hours: Monday is 0, Sunday is 6
BUSINESS_WORKDAYS=0,1,2,3,4
BUSINESS_START=09:00
BUSINESS_END=18:00
# BUSINESS_HOLIDAYS=2026-12-25,2027-01-01
